{
  "datasets": [
    {
      "name": "market_history",
      "displayName": "Market history",
      "queryLines": [
        "-- AI/BI dashboard dataset; edit ONLY this file, then `just build`. Catalog/schema come from the bundle.\nSELECT window_start, symbol, CAST(close_price AS DOUBLE) AS close_price,\n       CAST(vwap AS DOUBLE) AS vwap,\n       CAST(volume AS DOUBLE) AS volume,\n       trade_count,\n       max_ingest_lag_ms\nFROM trades_1m\nWHERE symbol = 'BTCUSDT'\nORDER BY window_start DESC\nLIMIT 500\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "market_page",
      "displayName": "Crypto Market Pulse",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "close_price_chart",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "market_history",
                  "fields": [
                    {
                      "name": "window_start",
                      "expression": "`window_start`"
                    },
                    {
                      "name": "close_price",
                      "expression": "`close_price`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "window_start",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "close_price",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "frame": {
                "title": "BTCUSDT close \u00b7 1m",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "vwap_chart",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "market_history",
                  "fields": [
                    {
                      "name": "window_start",
                      "expression": "`window_start`"
                    },
                    {
                      "name": "vwap",
                      "expression": "`vwap`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "window_start",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "vwap",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "frame": {
                "title": "BTCUSDT VWAP \u00b7 1m",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 6,
            "y": 0,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "volume_chart",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "market_history",
                  "fields": [
                    {
                      "name": "window_start",
                      "expression": "`window_start`"
                    },
                    {
                      "name": "volume",
                      "expression": "`volume`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "window_start",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "volume",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "frame": {
                "title": "BTCUSDT volume \u00b7 1m",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 6,
            "width": 12,
            "height": 6
          }
        }
      ]
    }
  ]
}
