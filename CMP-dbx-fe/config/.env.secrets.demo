# Copy to config/.env.secrets (git-ignored) and fill. Never commit real values.
# Managed Kafka (Confluent Cloud: cluster "Bootstrap server" + an API key/secret), used with CMP_PROFILE=cloud
KAFKA_BOOTSTRAP=
KAFKA_API_KEY=
KAFKA_API_SECRET=
# Databricks CLI profile from ~/.databrickscfg (`databricks auth profiles`)
DATABRICKS_CONFIG_PROFILE=
